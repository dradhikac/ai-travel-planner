# Runtime environment: development | test | production
APP_ENV=development

# Logging verbosity level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Comma-separated list of allowed CORS origins (explicit origins only, no wildcard '*')
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional database connection string (SQLAlchemy with psycopg v3 driver)
DATABASE_URL=postgresql+psycopg://postgres:change-me-local-only@localhost:5432/ai_travel_concierge
