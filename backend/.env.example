# Runtime environment: development | test | production
APP_ENV=development

# Logging verbosity level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Comma-separated list of allowed CORS origins (explicit origins only, no wildcard '*')
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional database connection string (SQLAlchemy with psycopg v3 driver)
DATABASE_URL=postgresql+psycopg://postgres:change-me-local-only@localhost:5432/ai_travel_concierge

# External provider mode: live | mock (mock returns deterministic offline fixtures)
PROVIDER_MODE=live

# Open-Meteo API endpoint URLs (override for testing or alternative gateways)
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast

# Open-Meteo client timeout configuration (seconds)
OPEN_METEO_CONNECT_TIMEOUT_SECONDS=3.0
OPEN_METEO_READ_TIMEOUT_SECONDS=5.0

# Open-Meteo max bounded retries for retryable network/5xx failures (0 disables retries)
OPEN_METEO_MAX_RETRIES=1
